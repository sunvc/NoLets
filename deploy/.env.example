# =============================================================================
# NoLet 推送服务环境变量示例
#
# 用法：
#   docker compose --env-file .env up -d
#   或：cp .env.example .env 后按需修改
#
# 优先级：配置文件(config.yaml)中显式写出的键 > 命令行参数 > 环境变量 > 内置默认值
# 即：config.yaml 里写了某个键，同名环境变量会被覆盖；文件中没有的键才使用环境变量。
# 不挂载/不指定 config 文件时，环境变量即为最高优先级。
#
# 布尔值：true / false（也接受 1/0、T/F）
# 时长值：Go duration 格式，如 3s、5m、1h30m
# 列表值：英文逗号分隔，如 NOLET_AUTHS=1001,1002
# =============================================================================

TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 服务基础配置
# -----------------------------------------------------------------------------

# 监听地址
NOLET_SERVER_ADDRESS=0.0.0.0:8080

# URL 前缀（反向代理子路径部署时使用，通常保持 /）
NOLET_SERVER_URL_PREFIX=/

# 数据目录（数据库、日志、证书等）
NOLET_SERVER_DATA_DIR=./data

# MySQL DSN（留空则使用 SQLite：user:pass@tcp(host:3306)/dbname?charset=utf8mb4）
NOLET_SERVER_DSN=

# TLS 证书与私钥路径（留空走 HTTP；可配合 NOLET_CUSTOM_HTTPS 自签）
NOLET_SERVER_CERT=
NOLET_SERVER_KEY=

# Basic Auth 管理后台账号密码
NOLET_SERVER_BASIC_AUTH_USER=
NOLET_SERVER_BASIC_AUTH_PASSWORD=

# 推送鉴权密码（设备注册接口 /register 使用的 X-USER 密钥校验）
NOLET_PUSH_PASSWORD=

# AES-GCM 签名密钥（必须与客户端 App 内置的一致，32 位）
NOLET_SIGN_KEY=ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEF

# 反向代理透传真实 IP 的请求头名（如 X-Real-IP）
NOLET_SERVER_PROXY_HEADER=

# ICP 备案信息（首页页脚展示，不需要留空）
NOLET_ICP_INFO=

# 时区（也可用容器的 TZ，如 Asia/Shanghai）
# NOLET_SERVER_TIME_ZONE=

# 日志文件路径
NOLET_LOG_PATH=./data/logs/app.log

# -----------------------------------------------------------------------------
# 性能与超时（一般无需修改）
# -----------------------------------------------------------------------------

# 降低内存占用（以更高 CPU 为代价）
NOLET_SERVER_REDUCE_MEMORY_USAGE=false

# 开启对讲语音路由
NOLET_SERVER_VOICE=false

# 批量推送最大数量，-1 表示不限制
NOLET_SERVER_MAX_BATCH_PUSH_COUNT=-1

# APNs 最大客户端连接数
NOLET_SERVER_MAX_APNS_CLIENT_COUNT=1

# 单个设备允许关联的 deviceKey 最大数量
NOLET_CONCURRENCY=10

# 最大并发连接数（隐藏参数）
NOLET_SERVER_CONCURRENCY=262144

# 读超时 / 写超时 / keep-alive 空闲超时（Go duration）
NOLET_SERVER_READ_TIMEOUT=3s
NOLET_SERVER_WRITE_TIMEOUT=3s
NOLET_SERVER_IDLE_TIMEOUT=10s

# Debug 调试模式
NOLET_DEBUG=false

# -----------------------------------------------------------------------------
# 功能开关
# -----------------------------------------------------------------------------

# 自定义 HTTPS：未配置证书时自动自签，且监听地址从 :8080 切到 :8443
NOLET_CUSTOM_HTTPS=false

# 代理下载开关
NOLET_PROXY_DOWNLOAD=false

# 隐藏首页：访问 / 仅返回 OK
NOLET_SERVER_HIDE_HOME=false

# 授权 ID 列表（逗号分隔，留空表示不限制）
NOLET_AUTHS=

# -----------------------------------------------------------------------------
# Apple APNs
# -----------------------------------------------------------------------------

# APNs 私钥（PEM 内容；建议通过 config.yaml 或密钥文件注入，不要直接写在 env 里）
NOLET_APPLE_APNS_PRIVATE_KEY=
NOLET_APPLE_TOPIC=me.uuneo.Meoworld
NOLET_APPLE_KEY_ID=BNY5GUGV38
NOLET_APPLE_TEAM_ID=FUWV6U942Q
NOLET_APPLE_DEVELOP=false

# -----------------------------------------------------------------------------
# HarmonyOS Push Kit（鸿蒙推送）
# 服务端通过 OAuth 2.0 client_credentials 获取 access token 后调用推送 API
# -----------------------------------------------------------------------------

NOLET_HM_PROJECT_ID=
NOLET_HM_KEY_ID=
NOLET_HM_PRIVATE_KEY=
NOLET_HM_SUB_ACCOUNT=
NOLET_HM_AUTH_URI=https://oauth-login.cloud.huawei.com
NOLET_HM_TOKEN_URI=https://oauth.cloud.huawei.com
NOLET_HM_AUTH_PROVIDER_CERT_URI=
NOLET_HM_CLIENT_CERT_URI=
NOLET_HM_CLIENT_ID=
